---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/notes";

interface Props {
  notes: CollectionEntry<"notes">[];
}

const { notes } = Astro.props;

// classic arrow pointer, 11x16, shown on hover
const POINTER = [
  "10000000000", "11000000000", "11100000000", "11110000000", "11111000000", "11111100000",
  "11111110000", "11111111000", "11111111100", "11111111110", "11111100000", "11101100000",
  "11000110000", "10000110000", "00000011000", "00000011000",
];
const pointerPath = POINTER.flatMap((row, y) =>
  [...row].map((c, x) => (c === "1" ? `M${x} ${y}h1v1h-1z` : ""))
).join("");
---

<ul class="notes">
  {notes.map(note => (
    <li>
      <a href={`/notes/${note.id}/`}>
        <svg class="ptr" viewBox="0 0 11 16" aria-hidden="true"><path d={pointerPath} /></svg>
        <span>
          <span class="title">{note.data.title}</span>
          <ul class="tags" aria-label="Tags">
            {note.data.tags.map(tag => <li>#{tag.toLowerCase()}</li>)}
          </ul>
        </span>
        <time class="label" datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
      </a>
    </li>
  ))}
</ul>

<style>
  .notes { list-style: none; margin: 0; padding: 0; }
  .notes > li > a {
    display: grid; grid-template-columns: 18px 1fr auto; gap: 0 10px; align-items: start;
    padding: 8px 10px; text-decoration: none; border-radius: 4px;
  }
  a:hover { background: var(--fg); color: var(--bg); }
  .ptr { width: 11px; height: 16px; shape-rendering: crispEdges; margin-top: 5px; visibility: hidden; fill: currentColor; }
  a:hover .ptr { visibility: visible; }
  .title { display: block; }
  time { font-size: 11px; white-space: nowrap; padding-top: 4px; }

  @media (max-width: 560px) {
    .notes > li > a { grid-template-columns: 1fr; padding: 8px 4px; }
    .ptr { display: none; }
    time { padding-top: 2px; }
  }
</style>
