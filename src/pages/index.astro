---
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import NoteList from "../components/NoteList.astro";
import { SITE, SOCIALS, NOW, EXPERIENCE } from "../consts";
import { getNotes } from "../lib/notes";

const notes = (await getNotes()).slice(0, SITE.NOTES_ON_HOMEPAGE);
---

<Base>
  <section class="hero">
    <p class="label">hello, world. i'm</p>
    <h1>Noelia Miranda</h1>
    <p class="lead">
      I'm a software engineer based in Córdoba, Argentina, who loves solving problems, tinkering with code, and learning new things.
      Right now, I'm building backend stuff at <a href="https://mercadolibre.com/">Mercado Libre</a>.
    </p>
    <div class="buttons">
      {SOCIALS.map((social, i) => (
        <a class:list={["btn", { default: i === 0 }]} href={social.HREF}>{social.NAME}</a>
      ))}
    </div>
  </section>

  <SectionHeading title="Now" />
  <div class="card">
    <dl class="now">
      {NOW.map(item => (
        <>
          <dt class="label">{item.LABEL}</dt>
          <dd>{item.TEXT}</dd>
        </>
      ))}
    </dl>
  </div>

  <SectionHeading title="Experience" />
  <ul class="xp">
    {EXPERIENCE.map(job => (
      <li>
        <span class="label">{job.WHEN}</span>
        <div>
          <div class="role">{job.ROLE}</div>
          <p>{job.WHAT}</p>
        </div>
      </li>
    ))}
  </ul>

  <SectionHeading title="Notes" link={{ href: "/notes/", label: "all notes →" }} />
  <NoteList notes={notes} />
</Base>

<style>
  .hero { padding: 64px 0 24px; }
  .hero .label { margin: 0 0 4px; }
  h1 { font: 600 44px/1.05 var(--pixel); margin: 0 0 12px; letter-spacing: .5px; }
  .lead { margin: 0; max-width: 46ch; }
  .buttons { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 22px; }

  .now { display: grid; grid-template-columns: 120px 1fr; row-gap: 8px; margin: 0; }
  .now dt { padding-top: 3px; }
  .now dd { margin: 0; }

  .xp { list-style: none; margin: 0; padding: 0; }
  .xp li { display: grid; grid-template-columns: 120px 1fr; gap: 0 16px; padding: 14px 0; border-bottom: 1px dashed var(--fg); }
  .xp li:last-child { border-bottom: 0; }
  .xp .label { padding-top: 3px; }
  .role { font: 600 16px var(--pixel); }
  .xp p { color: var(--muted); margin: 2px 0 0; }

  @media (max-width: 560px) {
    .hero { padding-top: 40px; }
    h1 { font-size: 36px; }
    .now, .xp li { grid-template-columns: 1fr; }
    .now dd + dt { margin-top: 6px; }
  }
</style>
