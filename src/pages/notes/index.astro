---
import Base from "../../layouts/Base.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import NoteList from "../../components/NoteList.astro";
import { NOTES } from "../../consts";
import { getNotes } from "../../lib/notes";

const notes = await getNotes();
const years = Map.groupBy(notes, note => note.data.date.getUTCFullYear());
---

<Base title={NOTES.TITLE} description={NOTES.DESCRIPTION}>
  <section class="intro">
    <h1>{NOTES.TITLE}</h1>
    <p>{NOTES.DESCRIPTION}</p>
  </section>

  {[...years].map(([year, yearNotes]) => (
    <section>
      <SectionHeading title={String(year)} />
      <NoteList notes={yearNotes} />
    </section>
  ))}
</Base>

<style>
  .intro { padding: 56px 0 0; }
  h1 { font: 600 36px/1.1 var(--pixel); margin: 0 0 8px; }
  .intro p { margin: 0; color: var(--muted); }
</style>
