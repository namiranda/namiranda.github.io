---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <section class="card">
    <p class="label">error 404</p>
    <h1>This page doesn't exist.</h1>
    <p>Maybe it moved, maybe it never was.</p>
    <a class="btn default" href="/">Go home</a>
  </section>
</Base>

<style>
  .card { margin-top: 64px; max-width: 420px; }
  .label { margin: 0; }
  h1 { font: 600 24px/1.2 var(--pixel); margin: 6px 0 8px; }
  p { margin: 0 0 20px; }
</style>
